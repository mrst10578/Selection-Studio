{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selection-studio.local/schemas/question.schema.json",
  "title": "Selection Studio Question",
  "type": "object",
  "required": ["id", "exam_id", "source_question_number", "subject", "grade", "question_regions", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "exam_id": {"type": "string", "minLength": 3},
    "source_question_number": {"type": "integer", "minimum": 1},
    "subject": {"enum": ["BIO", "MATH", "PHY", "CHEM"]},
    "grade": {"enum": [10, 11, 12]},
    "chapter": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "difficulty": {"type": ["string", "null"], "enum": ["level_1", "level_2", "level_3", "level_4", "level_5", null]},
    "correct_option": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
    "visual_hash": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{16}$"},
    "question_regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}},
    "answer_regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "biology_combination": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["is_combined", "topics"],
          "properties": {
            "is_combined": {"type": "boolean"},
            "topics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["grade", "chapter", "unit"],
                "properties": {
                  "grade": {"enum": [10, 11, 12]},
                  "chapter": {"type": "string", "pattern": "^(0[1-9]|1[0-2])$"},
                  "unit": {"type": "string", "pattern": "^0[1-8]$"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "status": {"enum": ["draft", "submitted", "verified", "rejected"]},
    "review_status": {"enum": ["pending", "approved", "needs_changes", "rejected"]},
    "review_note": {"type": ["string", "null"]},
    "entered_by": {"type": ["string", "null"]},
    "reviewed_by": {"type": ["string", "null"]},
    "duplicate_candidates": {"type": "array"}
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": ["page", "bbox_norm"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "bbox_norm": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
